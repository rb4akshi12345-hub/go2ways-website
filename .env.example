# ========================================================
# SMTP Email Configuration (Nodemailer)
# ========================================================
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465 (or 587)
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
#
# Example for Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password
#
# Example for Custom / Hosting Webmail:
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465 (or 587)
# SMTP_USER=support@go2ways.com
# SMTP_PASS=your_password

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=support@go2ways.com
NOTIFY_FROM="go2ways Inquiries" <support@go2ways.com>

# ========================================================
# (Optional) Static Web3Forms fallback for GitHub Pages
# ========================================================
NEXT_PUBLIC_WEB3FORMS_KEY=

# ========================================================
# (Optional) Anthropic Claude API for Phase 3 Chatbot
# ========================================================
ANTHROPIC_API_KEY=
