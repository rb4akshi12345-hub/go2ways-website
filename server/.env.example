# Copy this file to .env and fill in what you need. Never share or commit .env.

# --- AI chat (optional) ---------------------------------------------------
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Contact form inbox ----------------------------------------------------
# Password for the private inbox at http://localhost:5179/admin (any username).
ADMIN_PASSWORD=

# --- Email alerts for new messages (optional) ------------------------------
# Fill these in from your email provider's "SMTP" settings.
# Example for Google Workspace / Gmail: host smtp.gmail.com, port 465,
# user = the full address, pass = an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=support@go2ways.com
NOTIFY_FROM=

# --- Advanced (optional) ---------------------------------------------------
# PORT=5179
# HOST=127.0.0.1        # use 0.0.0.0 when deploying
# CHAT_MODEL=claude-opus-5-5
# DATA_DIR=./data       # where contact messages are saved
